  (gr_text "Datum (grid origin) = case centre. +X right, +Y up. Bottom edge at Y = -36.0." (at 103.5 153.2) (layer "Cmts.User") (tstamp 5d99fcc1-f088-41ce-814e-6edd01b80704)
    (effects (font (size 1 1) (thickness 0.15)) (justify left))
  )
  (gr_text "Keep copper back from both ends: antenna A is about 8 mm past the right edge; antenna B is 3 mm past the left edge, so the left strip (x < -39.5) is a no-copper area." (at 103.5 159.8) (layer "Cmts.User") (tstamp 63fa636c-6f3b-4198-8891-cb414784f5a3)
    (effects (font (size 1 1) (thickness 0.15)) (justify left))
  )
  (gr_text "Height: F 5.0 mm max (4.0 behind the button recess). B 3.7 mm max over the battery pack outline, about 15 elsewhere." (at 103.5 155.4) (layer "Cmts.User") (tstamp bb68037d-adff-484e-ad33-d8958ff17b15)
    (effects (font (size 1 1) (thickness 0.15)) (justify left))
  )
  (gr_text "Viewed from the front; F.Cu = front face (buttons, USB-C, 3.5 mm, power, lamp, motor). B.Cu: ESP32-S3, LR2021, codec, U.FL, JST SH, pogo pins." (at 103.5 151) (layer "Cmts.User") (tstamp d783ac24-48bb-46fa-84d3-a4b5f9c7b948)
    (effects (font (size 1 1) (thickness 0.15)) (justify left))
  )
  (gr_text "Antenna diversity: LR2021 ANT_LF -> pi match -> PE4259 SPDT -> U.FL A (right end) / U.FL B (left end). Control from an ESP32 GPIO." (at 103.5 157.6) (layer "Cmts.User") (tstamp e1cc9069-ca1a-4039-8abf-dbf380bf5736)
    (effects (font (size 1 1) (thickness 0.15)) (justify left))
  )
