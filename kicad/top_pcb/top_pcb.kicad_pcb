  (gr_text "Height: F 3.0 mm max (2.5 under keycap flanges, 1.4 under the OLED glass). B: encoders 6.5; nothing else inside R17.4 of each dial axis." (at 100.1 131.8) (layer "Cmts.User") (tstamp 7785a395-2f1d-4b62-8010-5c82ccd998fa)
    (effects (font (size 1 1) (thickness 0.15)) (justify left))
  )
  (gr_text "Viewed from above; F.Cu = top side (keys, OLED, status LEDs). B.Cu: encoders, OLED FPC connector, JST SH, IO expander." (at 100.1 127.4) (layer "Cmts.User") (tstamp a73e2f57-6e97-4ae8-98ba-cdd7ae2ce922)
    (effects (font (size 1 1) (thickness 0.15)) (justify left))
  )
  (gr_text "Datum (grid origin) = board centre, 15 mm behind the case front. +X right, +Y toward the hip (back) edge." (at 100.1 129.6) (layer "Cmts.User") (tstamp fc7d6ffa-1338-48d0-b15b-c0cb82102f2f)
